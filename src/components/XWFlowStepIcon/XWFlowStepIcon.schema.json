{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowStepIcon",
  "name": "XWFlow Step Icon",
  "description": "The glowing tile that marks a step's group, with an XWUI icon inside.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "icon",
        "group"
      ],
      "properties": {
        "icon": {
          "type": "string",
          "description": "XWUI icon name."
        },
        "group": {
          "type": "object"
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md"
          ]
        },
        "ghost": {
          "type": "boolean",
          "description": "Ghost tiles tint the outline instead of filling the tile."
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
