{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowChain",
  "name": "XWFlow Chain",
  "description": "A flow's steps in order, one coloured dot per step group.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "groups",
        "label"
      ],
      "properties": {
        "groups": {
          "type": "array"
        },
        "label": {
          "type": "string",
          "description": "Read by assistive technology in place of the dots."
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string"
        }
      }
    }
  }
}
