{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowNotationThumb",
  "name": "XWFlow Notation Thumb",
  "description": "A small drawing of the sample flow in one notation: BPMN, sequence, Petri net and so on.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "notation",
        "steps",
        "label"
      ],
      "properties": {
        "notation": {
          "type": "string",
          "description": "Notation id from the gallery, e.g. \"bpmn\" or \"uml-sequence\"."
        },
        "steps": {
          "type": "array"
        },
        "label": {
          "type": "string",
          "description": "Spoken description of the drawing."
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string"
        }
      }
    }
  }
}
