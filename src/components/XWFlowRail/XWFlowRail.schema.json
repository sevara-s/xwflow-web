{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowRail",
  "name": "XWFlow Rail",
  "description": "The Studio side rail: brand, global search (Ctrl K), Create, the project and chat lists, footer links and the run-usage meter. Items are links, so navigation, middle-click and screen readers behave as on any page.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "brand",
        "labels",
        "sections",
        "footer",
        "usage",
        "selected"
      ],
      "properties": {
        "brand": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "headTag": {
          "type": "object",
          "description": "A tag next to the brand, such as \"Admin\"."
        },
        "sections": {
          "type": "array"
        },
        "footer": {
          "type": "array"
        },
        "usage": {
          "type": [
            "number",
            "null"
          ]
        },
        "selected": {
          "type": "string"
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "collapsed": {
          "type": "boolean"
        },
        "slim": {
          "type": "boolean",
          "description": "The narrower admin rail."
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
