{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowSparkBars",
  "name": "XWFlow Spark Bars",
  "description": "A compact bar sparkline (runs per hour) where failing periods turn red.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "bars",
        "label"
      ],
      "properties": {
        "bars": {
          "type": "array"
        },
        "label": {
          "type": "string",
          "description": "Spoken summary; the bars themselves are decorative."
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number"
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
