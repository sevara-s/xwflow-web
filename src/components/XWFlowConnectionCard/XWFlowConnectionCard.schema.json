{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowConnectionCard",
  "name": "XWFlow Connection Card",
  "description": "A stored credential. It shows who owns it, what it may do, its health and a masked value with no reveal control: secrets stay in the vault.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "name",
        "subtitle",
        "icon",
        "group",
        "status",
        "mask",
        "maskLabel",
        "note",
        "tags",
        "action"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subtitle": {
          "type": "string",
          "description": "\"OAuth, owned by You\""
        },
        "icon": {
          "type": "string"
        },
        "group": {
          "type": "object"
        },
        "status": {
          "type": "object"
        },
        "mask": {
          "type": "string",
          "description": "The masked value. The real secret never reaches the browser."
        },
        "maskLabel": {
          "type": "string"
        },
        "note": {
          "type": "object",
          "description": "Body text; `emphasis` is drawn bold where it appears in `text`."
        },
        "tags": {
          "type": "array"
        },
        "action": {
          "type": "object"
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string"
        }
      }
    }
  }
}
