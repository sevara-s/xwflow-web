{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowStackedBars",
  "name": "XWFlow Stacked Bars",
  "description": "Stacked columns over time: the healthy part as a gradient, failures in red on top.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "bars",
        "label",
        "start",
        "end"
      ],
      "properties": {
        "bars": {
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "description": "Captions under the first and last bar."
        },
        "end": {
          "type": "string"
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number"
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
