{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "XWFlowDiagram",
  "name": "XWFlow Diagram",
  "description": "One flow drawn in a standard notation: an ISO 5807 flowchart, swimlanes by system, a BPMN 2.0 collaboration, or a UML sequence built from a real run receipt, where each numbered dot is a ledger row.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "mode",
        "steps",
        "edges",
        "systems",
        "attempts",
        "labels"
      ],
      "properties": {
        "mode": {
          "type": "object"
        },
        "steps": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        },
        "systems": {
          "type": "array"
        },
        "attempts": {
          "type": "array",
          "description": "Attempts of the run a sequence diagram is drawn from."
        },
        "labels": {
          "type": "object",
          "description": "Words drawn inside the diagram."
        },
        "selectedAttempt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Highlight one ledger row in the sequence."
        }
      }
    },
    "conf_comp": {
      "type": "object",
      "properties": {
        "laneBy": {
          "type": "string",
          "enum": [
            "system",
            "group"
          ],
          "description": "Lane by system (default) or one lane per step group."
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
